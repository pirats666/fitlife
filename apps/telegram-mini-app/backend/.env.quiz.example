# Existing backend secrets
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public HTTPS endpoint that receives Telegram POST updates
TELEGRAM_WEBHOOK_URL=https://YOUR-DOMAIN.example/api/telegram/webhook

# Optional secret used to verify Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=

# Telegram username for the trainer CTA, without @
TRAINER_TELEGRAM_USERNAME=

# Your own Telegram numeric ID for /admin
ADMIN_TELEGRAM_ID=

# PDF files are stored in Supabase Storage and their public/signed URLs are saved
# in public.programs.pdf_url. No PDF URL environment variables are required.
